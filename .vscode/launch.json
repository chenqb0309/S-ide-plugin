{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "執行 S-IDE 外掛",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${input:workspace}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ],
  "inputs": [
    {
      "id": "workspace",
      "type": "promptString",
      "description": "要用哪個資料夾當工作區？（含 .sem 的規格專案，或含 .cs 的文件測試專案）",
      "default": "${workspaceFolder}"
    }
  ]
}
