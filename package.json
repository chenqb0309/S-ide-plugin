{
  "name": "s-ide-plugin",
  "displayName": "S-IDE",
  "description": "%side.description%",
  "version": "0.1.0",
  "publisher": "chenqb0309",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenqb0309/S-ide-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/chenqb0309/S-ide-plugin/issues"
  },
  "homepage": "https://github.com/chenqb0309/S-ide-plugin#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Documentation",
    "Other"
  ],
  "keywords": [
    "semantic",
    "documentation",
    "csharp",
    "markdown"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:side.docs",
    "onCommand:side.syncDocs",
    "onCommand:side.rebuildDocs",
    "onCommand:side.setApiKey",
    "onCommand:side.openSettings"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "side",
          "title": "S-IDE",
          "icon": "resources/side.svg"
        }
      ]
    },
    "views": {
      "side": [
        {
          "id": "side.docs",
          "name": "%side.view.docs%"
        }
      ]
    },
    "configuration": {
      "title": "S-IDE",
      "properties": {
        "side.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-TW"
          ],
          "default": "en",
          "enumDescriptions": [
            "%side.cfg.language.en%",
            "%side.cfg.language.zh%"
          ],
          "description": "%side.cfg.language.desc%"
        },
        "side.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "markdownDescription": "%side.cfg.baseUrl.desc%"
        },
        "side.model": {
          "type": "string",
          "default": "",
          "description": "%side.cfg.model.desc%"
        },
        "side.docsDir": {
          "type": "string",
          "default": "semDocs",
          "description": "%side.cfg.docsDir.desc%"
        }
      }
    },
    "commands": [
      {
        "command": "side.syncDocs",
        "title": "%side.cmd.sync%",
        "icon": "$(book)"
      },
      {
        "command": "side.rebuildDocs",
        "title": "%side.cmd.rebuild%",
        "icon": "$(refresh)"
      },
      {
        "command": "side.openSettings",
        "title": "%side.cmd.settings%",
        "icon": "$(gear)"
      },
      {
        "command": "side.setApiKey",
        "title": "%side.cmd.setKey%",
        "icon": "$(key)"
      },
      {
        "command": "side.openSource",
        "title": "%side.cmd.openSource%",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "side.openSource",
          "when": "view == side.docs && viewItem == side.file",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "side.syncDocs",
          "when": "view == side.docs",
          "group": "navigation@1"
        },
        {
          "command": "side.rebuildDocs",
          "when": "view == side.docs",
          "group": "navigation@2"
        },
        {
          "command": "side.openSettings",
          "when": "view == side.docs",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "side.syncDocs",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "side.syncDocs",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "side.rebuildDocs",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "check": "node scripts/check-layering.mjs",
    "vscode:prepublish": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0"
  }
}
