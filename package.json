{
  "name": "s-ide-plugin",
  "displayName": "S-IDE",
  "description": "把既有 C# 原始碼翻成帶呼叫鏈的 Markdown 文件群，讓人看得懂程式在做什麼。",
  "version": "0.1.0",
  "publisher": "chenqb0309",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Documentation",
    "Other"
  ],
  "keywords": [
    "semantic",
    "documentation",
    "csharp",
    "markdown"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:side.syncDocs",
    "onCommand:side.rebuildDocs",
    "onCommand:side.setApiKey",
    "onCommand:side.openSettings"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "side",
          "title": "S-IDE",
          "icon": "resources/side.svg"
        }
      ]
    },
    "views": {
      "side": [
        {
          "id": "side.docs",
          "name": "語義文件"
        }
      ]
    },
    "configuration": {
      "title": "S-IDE",
      "properties": {
        "side.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "markdownDescription": "OpenAI 相容端點。例如 OpenAI、DeepSeek、OpenRouter、本機 Ollama、OpenCode Go…"
        },
        "side.model": {
          "type": "string",
          "default": "",
          "description": "模型名稱，例如 gpt-4o-mini、deepseek-chat、qwen2.5-coder:7b"
        },
        "side.docsDir": {
          "type": "string",
          "default": "semDocs",
          "description": "語義文件輸出目錄（相對 workspace 根）。不存在時視為尚未建立。"
        }
      }
    },
    "commands": [
      {
        "command": "side.syncDocs",
        "title": "S-IDE: 同步語義文件",
        "icon": "$(book)"
      },
      {
        "command": "side.rebuildDocs",
        "title": "S-IDE: 重建全部語義文件",
        "icon": "$(refresh)"
      },
      {
        "command": "side.setApiKey",
        "title": "S-IDE: 設定 API Key",
        "icon": "$(key)"
      },
      {
        "command": "side.openSettings",
        "title": "S-IDE: 開啟設定",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "side.syncDocs",
          "when": "view == side.docs",
          "group": "navigation@1"
        },
        {
          "command": "side.rebuildDocs",
          "when": "view == side.docs",
          "group": "navigation@2"
        },
        {
          "command": "side.openSettings",
          "when": "view == side.docs",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "side.syncDocs",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "side.syncDocs",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "side.rebuildDocs",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "check": "node scripts/check-layering.mjs",
    "vscode:prepublish": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0"
  }
}
