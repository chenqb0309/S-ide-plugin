# PalletStacker.sem
#
# 輕量樣本：零外部依賴、零資料庫，一分鐘能講完。
#
# 語言界線：
#   框架：英文的習慣寫法 —— class / func / in / out / int / decimal
#   識別字：一律 ASCII（中文命名會讓生成的程式碼出問題，lint 會擋）
#   敘述：中文 —— 那是給人讀的語義層，AI 自己會轉

data BoxSpec {
    decimal Weight
    int Length
    int Width
    int Height
}

class PalletStacker {
    func BoxesPerLayer {
        in: BoxSpec spec
        out: int

        步驟 "判斷重量級距"
        如果 spec.Weight 大於 15 {
            返回 4
        }
        返回 8
    }

    func LayersFor {
        in: BoxSpec spec, int palletHeight
        out: int

        步驟 "計算層數"
        返回 palletHeight 除以 spec.Height
    }
}

# 進入點。慣例：class App 的無參數 func Main，由 harness 機械生成 Program.cs 呼叫它。
class App {
    func Main {
        步驟 "建立樣本"
        建立一個 18 公斤、400x300x250 的 BoxSpec
        建立一個 PalletStacker
        呼叫 `PalletStacker.BoxesPerLayer` 並輸出結果
        呼叫 `PalletStacker.LayersFor`，棧板高度 1800，並輸出結果
    }
}
